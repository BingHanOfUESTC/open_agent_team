\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Learned $\gamma $ values across all 3 seeds (M config, 5000 iterations). All learned $\gamma $ are negative, peaking at layers 3--4 (mid-depth) with $|\gamma | \approx 0.15$--$0.25$. The model uniformly prefers smoothing over sharpening.\relax }}{5}{figure.caption.2}\protected@file@percent }
\newlabel{fig:learned_gamma}{{2}{5}{Learned $\gamma $ values across all 3 seeds (M config, 5000 iterations). All learned $\gamma $ are negative, peaking at layers 3--4 (mid-depth) with $|\gamma | \approx 0.15$--$0.25$. The model uniformly prefers smoothing over sharpening.\relax }{figure.caption.2}{}}
