\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces ADDC $\gamma $ sweep (1500 iterations, seed 42). $\gamma \geq 0.1$ causes complete training failure---loss remains at random initialization level. Only $\gamma \leq 0.05$ allows learning. The best fixed $\gamma = 0.01$ achieves a 10.4\% PPL improvement over standard at this intermediate training stage.\relax }}{5}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:gamma_sweep}{{1}{5}{ADDC $\gamma $ sweep (1500 iterations, seed 42). $\gamma \geq 0.1$ causes complete training failure---loss remains at random initialization level. Only $\gamma \leq 0.05$ allows learning. The best fixed $\gamma = 0.01$ achieves a 10.4\% PPL improvement over standard at this intermediate training stage.\relax }{figure.caption.1}{}}
